# Copy to .env only if you want to override the defaults.
# The backend reads these from the process environment (it does not load .env by itself).

PORT=3000
LLM_BASE_URL=http://127.0.0.1:8000

# n8n production webhook. The workflow must be Active.
N8N_ENABLED=true
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/secure-mom

# Mailpit on this laptop. Inbox UI is http://localhost:8025
SMTP_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=mom-bot@medpark.local
